<Window x:Class="SP_RezervaceZasedacichMistnosti.Views.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Rezervace zasedacích místností" Width="1250" Height="720" MinWidth="900" MinHeight="480">
<DockPanel Margin="18">
<StackPanel DockPanel.Dock="Top">
<TextBlock Text="Rezervace zasedacích místností" FontSize="26" FontWeight="SemiBold"/>
<WrapPanel><Button Content="Obnovit / Vyhledat" Command="{Binding ObnovitCommand}"/><Button Content="Zaměstnanci" Command="{Binding ZamestnanciCommand}"/><Button Content="Místnosti" Command="{Binding MistnostiCommand}"/></WrapPanel>
<WrapPanel><TextBlock Text="Zobrazení:"/><ComboBox ItemsSource="{Binding Obdobi}" SelectedItem="{Binding VybraneObdobi}"/><TextBlock Text="Místnost:"/><ComboBox ItemsSource="{Binding Mistnosti}" DisplayMemberPath="Nazev" SelectedItem="{Binding MistnostFiltr}"/><TextBlock Text="Zaměstnanec:"/><ComboBox ItemsSource="{Binding Zamestnanci}" DisplayMemberPath="CeleJmeno" SelectedItem="{Binding ZamestnanecFiltr}"/></WrapPanel>
</StackPanel>
<StackPanel DockPanel.Dock="Bottom"><WrapPanel><Button Content="Přidat" Command="{Binding PridatCommand}"/><Button Content="Změnit" Command="{Binding ZmenitCommand}"/><Button Content="Smazat" Command="{Binding SmazatCommand}"/></WrapPanel><TextBlock Text="Časy jsou místní. Probíhající rezervace a historie jsou pouze ke čtení. Stav aktualizujete tlačítkem Obnovit."/></StackPanel>
<DataGrid ItemsSource="{Binding Polozky}" SelectedItem="{Binding Selected}" IsReadOnly="True"><DataGrid.Columns>
<DataGridTextColumn Header="ID" Binding="{Binding Id}"/><DataGridTextColumn Header="Místnost" Binding="{Binding Mistnost.Nazev}"/><DataGridTextColumn Header="Zaměstnanec" Binding="{Binding Zamestnanec.CeleJmeno}"/>
<DataGridTextColumn Header="Od" Binding="{Binding CasOd, Converter={StaticResource LocalTime}}"/><DataGridTextColumn Header="Do" Binding="{Binding CasDo, Converter={StaticResource LocalTime}}"/>
<DataGridTextColumn Header="Účel" Binding="{Binding Ucel}" Width="*"/><DataGridTextColumn Header="Stav" Binding="{Binding Stav, Converter={StaticResource EnumDescription}}"/>
<DataGridTextColumn Header="Vytvořeno" Binding="{Binding DatumVytvoreni, Converter={StaticResource LocalTime}}"/>
</DataGrid.Columns></DataGrid>
</DockPanel></Window>
